#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&led_strip { chain-length = <27>; };

/ {
    behaviors {
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41 38 37 36>;
            hold-trigger-on-release;
        };

        hyper: hyper {
            compatible = "zmk,behavior-mod-morph";
            label = "HYPER";
            bindings = <&none>, <&none>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_RSFT|MOD_RGUI)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&lt 2 TAB     &kp Q            &kp W            &kp E                &kp R              &kp T                 &kp Y                   &kp U               &kp I                 &kp O             &kp P                     &lt 2 BACKSLASH
&lt 1 ESCAPE  &hml LEFT_GUI A  &hml LEFT_ALT S  &hml LEFT_CONTROL D  &hml LEFT_SHIFT F  &kp G                 &kp H                   &hmr RIGHT_SHIFT J  &hmr RIGHT_CONTROL K  &hmr RIGHT_ALT L  &hmr RIGHT_GUI SEMICOLON  &lt 1 SQT
&kp LSHFT     &kp Z            &kp X            &kp C                &kp V              &kp B                 &kp N                   &kp M               &kp COMMA             &kp DOT           &kp SLASH                 &kp RIGHT_SHIFT
                                                &hyper               &kp TAB            &mt LEFT_GUI ENTER    &mt LEFT_CONTROL SPACE  &kp BACKSPACE       &caps_word
            >;
        };

        raise_layer {
            display-name = "RAI";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp EXCL            &kp AT                  &kp HASH                    &kp DLLR                  &kp PRCNT    &kp CARET       &kp AMPS                &kp ASTERISK              &kp LPAR                     &kp RPAR                      &kp BACKSLASH
&trans  &hml LGUI NUMBER_1  &hml LEFT_ALT NUMBER_2  &hml LEFT_CONTROL NUMBER_3  &hml LEFT_SHIFT NUMBER_4  &kp N5       &kp UNDERSCORE  &hmr RIGHT_SHIFT EQUAL  &hmr RIGHT_CONTROL GRAVE  &hmr RIGHT_ALT LEFT_BRACKET  &hmr RIGHT_GUI RIGHT_BRACKET  &kp PIPE
&trans  &kp NUMBER_6        &kp N7                  &kp N8                      &kp N9                    &kp N0       &kp MINUS       &kp PLUS                &kp TILDE                 &kp LEFT_BRACE               &kp RIGHT_BRACE               &trans
                                                    &trans                      &trans                    &trans       &trans          &trans                  &trans
            >;
        };

        lower_layer {
            display-name = "LOW";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans      &kp F1        &kp F2             &kp F3           &kp F4        &kp F5          &kp F6    &kp F7    &kp F8  &kp F9     &kp F10    &kp F11
&trans      &kp C_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRI_DN  &kp C_BRI_UP    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp PSCRN  &kp F12
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2     &bt BT_SEL 3  &trans          &trans    &trans    &trans  &trans     &trans     &tog 3
                                             &trans           &trans        &trans          &trans    &trans    &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans       &trans        &trans        &trans     &trans      &trans  &trans
&trans  &trans  &kp S   &kp D   &kp F   &trans       &trans        &kp J         &kp K      &kp L       &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans        &kp M         &kp COMMA  &kp PERIOD  &trans  &tog 3
                        &trans  &trans  &kp SPACE    &kp NUMBER_1  &kp NUMBER_2  &trans
            >;
        };
    };
};
